; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Un Breve Paseo por las Afueras de Pulkilastia"
run/main_scene="uid://cml180sj3hcwe"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/art/2d/sprites/icon.svg"

[autoload]

Globals="*uid://dsewn4nymm5f2"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-logger/plugin.cfg", "res://addons/plugin_refresher/plugin.cfg")

[file_customization]

